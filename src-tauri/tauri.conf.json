{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "StorageRelief",
  "version": "1.0.0",
  "identifier": "com.storagerelief.app",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "StorageRelief — Smart Windows Storage Optimizer",
        "width": 1080,
        "height": 740,
        "minWidth": 920,
        "minHeight": 640,
        "center": true,
        "resizable": true,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
